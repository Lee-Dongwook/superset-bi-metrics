{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm build:packages && webpack --mode production",
    "dev": "pnpm build:packages && webpack serve --mode development",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@bi-metrics/core": "workspace:*",
    "@bi-metrics/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googleapis/sheets": "^18.1.1",
    "@visx/axis": "^4.0.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "use-event-callback": "^0.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "postcss": "^8.5.30",
    "postcss-loader": "^8.2.1",
    "storybook": "10.6.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/",
      "/e2e/"
    ],
    "moduleNameMapper": {
      "^lodash-es$": "lodash"
    }
  }
}
