{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@bi-metrics/plugin-echarts/*": ["./src/*"],
      "@bi-metrics/ui/*": ["../../packages/ui/lib/*"],
      "*": ["../../*"]
    },
    "outDir": "lib",
    "rootDir": "src",
    "declarationDir": "lib"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "types/**/*", "src"],
  "exclude": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.test.*",
    "src/**/*.stories.*"
  ]
}
