{
  "name": "@bi-metrics/ui",
  "files": [
    "esm",
    "lib"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "esm/index.js",
  "exports": {
    ".": {
      "import": "./esm/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./components/*": {
      "import": "./esm/components/*/index.js",
      "require": "./lib/components/*/index.js",
      "types": "./lib/components/*/index.d.ts"
    },
    "./components": {
      "import": "./esm/components/index.js",
      "require": "./lib/components/index.js",
      "types": "./lib/components/index.d.ts"
    },
    "./utils/*": {
      "import": "./esm/utils/*.js",
      "require": "./lib/utils/*.js",
      "types": "./lib/utils/*.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@types/d3-format": "^3.0.4",
    "@types/json-bigint": "^1.0.4",
    "ace-builds": "^1.44.0",
    "ag-grid-community": "^36.2.0",
    "brace": "^0.11.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "math-expression-evaluator": "^2.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-table": "^7.8.0"
  }
}
