{
  "name": "@bi-metrics/chart-control",
  "version": "0.1.0",
  "files": [
    "lib",
    "src/style.css"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./style.css": "./src/style.css",
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf lib tsconfig.tsbuildinfo",
    "build": "pnpm clean && tsc --build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bi-metrics/ui": "workspace:*",
    "ace-builds": "^1.44.0",
    "brace": "^0.11.1",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "memoize-one": "^6.0.0",
    "react": "^19.3.0",
    "react-ace": "^15.0.0",
    "react-dom": "^19.3.0",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.0"
  }
}
